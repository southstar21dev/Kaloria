{
  "branches": ["master"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/exec", { "prepareCmd": "scripts/build-release.sh ${nextRelease.version}" }],
    ["@semantic-release/github", {
      "assets": [
        { "path": "build/release/*-arm64-v8a.apk", "label": "Kaloria ${nextRelease.version} (arm64-v8a, most phones)" },
        { "path": "build/release/*-universal.apk", "label": "Kaloria ${nextRelease.version} (universal)" }
      ],
      "successComment": false,
      "failComment": false,
      "releasedLabels": false
    }]
  ]
}
